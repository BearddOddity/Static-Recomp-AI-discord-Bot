# Discord
DISCORD_TOKEN=
# Optional: a server ID makes slash commands appear immediately while testing
DISCORD_GUILD_ID=

# Pick one: anthropic, openrouter, groq, gemini, openai_compatible, ollama, cli
AI_PROVIDER=openrouter
AI_TIMEOUT=60
# Seconds each user must wait between /ask uses. 0 turns the limit off.
ASK_COOLDOWN_SECONDS=30
AI_SYSTEM_PROMPT=You are a helpful assistant for a Discord community about static recompiled games.

# Claude (paid, Anthropic API key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Hosted free tiers: openrouter, groq and gemini all use these two settings.
# Set the model to one your account can use (OpenRouter ":free" models work well).
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# OpenRouter only, optional: how your bot is credited on openrouter.ai
OPENROUTER_APP_NAME=Static Recomp AI Discord Bot
OPENROUTER_SITE_URL=
# Only needed for AI_PROVIDER=openai_compatible
OPENAI_COMPAT_BASE_URL=

# Local model via Ollama (runs on the same machine as the bot)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local CLI tool. The prompt goes to stdin and the reply is read from stdout.
AI_CLI_COMMAND=

# GitHub docs the bot answers from, comma separated: owner/repo[@branch][:folder]
# owner/repo.wiki reads that repo's wiki (needs git installed on the bot's machine).
DOCS_REPOS=sp00nznet/xboxrecomp,sp00nznet/ps3recomp,rexglue/rexglue-sdk,rexglue/rexglue-sdk.wiki
# Keywords that point a question at one repo: words=owner/repo, rules separated by ";".
# Checked in order, so "Xbox 360" goes to rexglue before plain "Xbox" is considered.
DOCS_ROUTES=xbox 360,xbox360,x360,360=rexglue/rexglue-sdk; xbox=sp00nznet/xboxrecomp; ps3=sp00nznet/ps3recomp
# Optional. Raises GitHub's limit from 60 to 5000 requests/hour and allows private repos.
# A fine-grained token with read-only "Contents" access is enough.
GITHUB_TOKEN=
# How often to re-download docs. 0 loads them once at startup.
DOCS_REFRESH_MINUTES=360
# How many doc sections to give the AI per question.
DOCS_EXCERPTS=4

# --- Moderation (scams and piracy) ---
MOD_ENABLED=true
# Channel ID where the bot reports what it found (with the images as evidence)
MOD_LOG_CHANNEL_ID=
# What to do with a scam: flag (report only) or delete. Start with flag and
# switch to delete once you trust the results.
MOD_ACTION=flag
# Same for piracy. Flag is safer: people often discuss dumping their own games.
MOD_PIRACY_ACTION=flag
# Time out scam posters (often hacked accounts) for this many minutes. 0 = off.
MOD_TIMEOUT_MINUTES=0
# When to ask the AI: off, suspicious (only posts the rules find risky, or with
# 2+ images or new accounts; cheapest) or all (every message; costly).
MOD_AI_SCAN=suspicious
# Optional model just for moderation. Must accept images to catch screenshot
# scams, e.g. a Claude model or an OpenRouter model with image input.
MOD_AI_MODEL=
# How sure the AI must be (0-1) before a post is flagged
MOD_MIN_CONFIDENCE=0.75
# Role IDs never moderated (people with Manage Messages are always skipped)
MOD_EXEMPT_ROLE_IDS=
# Extra domains, comma separated, on top of bot/moderation/data/*.txt
MOD_BLOCKED_DOMAINS=
MOD_ALLOWED_DOMAINS=
