# Optional: a file with one server's details (topic, docs repos, keywords), so this
# .env only holds secrets and IDs. Values set here in .env win over the profile.
# Example: SERVER_PROFILE=servers/static-recomp/server.env
SERVER_PROFILE=

# What your community is about, in a few words. The AI uses it for /ask and
# moderation, e.g. "retro handheld modding" or "speedrunning Nintendo games".
COMMUNITY_ABOUT=

# Most settings below can also be changed from Discord with /settings (see docs/SETTINGS.md).
# Values saved that way are kept in data/settings.json and win over this file.

# Discord
DISCORD_TOKEN=
# Optional: a server ID makes slash commands appear immediately while testing
DISCORD_GUILD_ID=

# Pick one: anthropic, openrouter, groq, gemini, openai_compatible, ollama, cli
AI_PROVIDER=openrouter
AI_TIMEOUT=60
# Seconds each member must wait between questions. 0 turns the limit off.
ASK_COOLDOWN_SECONDS=10
# Named model lists the /ai-mode command can switch /ask between (needs Manage Server).
# Format: name=model,backup; name=model,backup. "default" always means OPENAI_COMPAT_MODEL.
# The choice is saved in data/ai_mode.txt and survives restarts.
AI_MODES=

# Backup AI: a second provider used when the main one fails or runs out of quota.
# groq and gemini have free tiers; openrouter works too with a second account's key.
# AI_BACKUP_VISION_MODEL (optional) is the model used for moderation, which reads images.
AI_BACKUP_PROVIDER=
AI_BACKUP_API_KEY=
AI_BACKUP_MODEL=
AI_BACKUP_VISION_MODEL=
AI_BACKUP_BASE_URL=

# Optional: replaces the built-in personality (a calm, witty AI butler, see PERSONA in
# bot/assist.py). {name}, {server} and {community} are filled in.
AI_SYSTEM_PROMPT=
# Channel IDs, comma separated, where the bot answers every message, like a chat
# with an assistant. Everywhere else it answers /ask, mentions and replies to it.
ASSISTANT_CHANNEL_IDS=
# How many recent channel messages the bot reads for context before answering. 0 = none.
# (0-20. Moderators can change it live with /tune; see docs/TUNING.md.)
CHAT_CONTEXT_MESSAGES=8

# Claude (paid, Anthropic API key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Hosted free tiers: openrouter, groq and gemini all use these two settings.
OPENAI_COMPAT_API_KEY=
# One model, or several comma separated: the first is used and the rest are backups
# when it's busy or gone. With OpenRouter you can leave it empty: the bot picks a
# free model itself. Tip: with a server profile, set models there, not here, so the
# bot's pull requests for model swaps take effect (.env wins over the profile).
OPENAI_COMPAT_MODEL=
# OpenRouter: when every listed model fails, try today's free models instead of
# going quiet. Free models come and go, so this keeps the bot answering.
OPENROUTER_FREE_FALLBACK=true
# OpenRouter only, optional: how your bot is credited on openrouter.ai
OPENROUTER_APP_NAME=
OPENROUTER_SITE_URL=
# Only needed for AI_PROVIDER=openai_compatible
OPENAI_COMPAT_BASE_URL=

# Local model via Ollama (runs on the same machine as the bot)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local CLI tool. The prompt goes to stdin and the reply is read from stdout.
AI_CLI_COMMAND=

# GitHub docs the bot answers from, comma separated: owner/repo[@branch][:folder]
# owner/repo.wiki reads that repo's wiki (needs git installed on the bot's machine).
# Example: DOCS_REPOS=owner/tool,owner/tool.wiki,owner/other-tool@main:docs
DOCS_REPOS=
# Keywords that point a question at one repo: words=owner/repo, rules separated by ";".
# Checked in order, so put longer names first: "switch 2=owner/a; switch=owner/b".
DOCS_ROUTES=
# Optional. Raises GitHub's limit from 60 to 5000 requests/hour and allows private repos.
# A fine-grained token with read-only "Contents" access is enough.
GITHUB_TOKEN=
# How often to re-download docs. 0 loads them once at startup.
DOCS_REFRESH_MINUTES=360
# How many doc sections to give the AI per question.
DOCS_EXCERPTS=4
# Let the AI rephrase a question into the words the docs use before searching:
# fallback (only when the first search matches poorly; the default), always
# (best answers, one extra AI call per question) or off.
DOCS_AI_QUERY=fallback
# Members can also ask by mentioning the bot, and ask follow-ups by replying to its answer.
ASK_ON_MENTION=true

# --- Moderation (scams and piracy) ---
MOD_ENABLED=true
# Channel ID where the bot reports what it found (with the images as evidence)
MOD_LOG_CHANNEL_ID=
# What a warning does with the offending message: delete (remove it, keep a copy
# in the case report) or flag (leave it up for a moderator to judge).
MOD_ACTION=delete
# Same for piracy the AI suspects (e.g. someone asking for an ISO). Shared game
# files and piracy-site links are certain, so they are always deleted.
MOD_PIRACY_ACTION=delete
# Same for breaking a rule from the rules channel.
MOD_RULE_ACTION=delete
# Hate speech always times the member out until a moderator reviews the case.
# This decides whether the message is also deleted right away.
MOD_HATE_ACTION=delete
# Discord AutoMod's "Slurs" filter always counts as hate speech. List IDs of your
# own AutoMod keyword rules here if they should count too. Profanity never does.
MOD_HATE_AUTOMOD_RULE_IDS=

# Warnings: each violation is a warning, DM'd to the member. At MOD_WARN_LIMIT
# active warnings (the 3rd) the member is timed out until a moderator reviews the case.
# The bot never bans; moderators decide with the buttons on the case report.
MOD_WARN_LIMIT=3
# Warnings older than this stop counting. 0 = never expire.
MOD_WARN_EXPIRY_DAYS=90
# Optional: set to true so scams the AI is at least MOD_SEVERE_CONFIDENCE sure of
# (or a known scam domain) skip the ladder and go straight to a timeout pending
# review. Off by default: every scam is a warning like anything else.
MOD_SEVERE_SCAM_REVIEW=false
MOD_SEVERE_CONFIDENCE=0.9
# DM members when they are warned
MOD_DM_WARNINGS=true
# Where cases, warnings and the rules copy are stored
MOD_DB_PATH=data/moderation.sqlite3

# Rules channel the bot reads and enforces. Empty = the server's Community rules
# channel, or the first channel with "rules" in its name. Re-read on every change.
RULES_CHANNEL_ID=
# When to ask the AI: off, suspicious (only posts the rules find risky, or with
# 2+ images or new accounts; cheapest) or all (every message; costly, but needed
# to catch every kind of rules-channel violation, not just scams and piracy).
MOD_AI_SCAN=suspicious
# Optional model just for moderation. Must accept images to catch screenshot
# scams, e.g. a Claude model or an OpenRouter model with image input. Comma
# separated backups work here too, and OpenRouter falls back to free image models.
MOD_AI_MODEL=
# How sure the AI must be (0.5-0.99) before a post is flagged. Moderators can change it
# live with /tune (saved in data/tuning.json, which then wins over this value). See docs/TUNING.md.
MOD_MIN_CONFIDENCE=0.75
# Role IDs never moderated (people with Manage Messages are always skipped)
MOD_EXEMPT_ROLE_IDS=
# Extra domains, comma separated, on top of bot/moderation/data/*.txt
MOD_BLOCKED_DOMAINS=
MOD_ALLOWED_DOMAINS=
# Extra piracy sites, on top of bot/moderation/data/piracy_domains.txt
MOD_PIRACY_DOMAINS=

# --- Staying online ---
# Self-update: when the bot runs from a git clone, it pulls new commits from GitHub
# every UPDATE_CHECK_MINUTES and restarts with them. Local edits are never overwritten.
AUTO_UPDATE=true
UPDATE_CHECK_MINUTES=30
# Branch to follow. Empty = the one this clone is on (normally main).
UPDATE_BRANCH=

# AI health: when a model disappears or the key stops working, the bot posts in the
# mod log. With these set, it also opens a pull request that swaps in a working
# model (in HEALTH_PR_FILE, by default your SERVER_PROFILE), or an issue asking for a
# new key (keys never go in git). Use a fine-grained token for this repo only, with
# Contents, Pull requests and Issues set to "Read and write". The bot never merges.
HEALTH_GITHUB_REPO=
HEALTH_GITHUB_TOKEN=
HEALTH_PR_FILE=

# --- Community: appeals, help threads, welcome (docs/COMMUNITY.md; also in /settings) ---
# Warned members get an Appeal button in their DM; moderators accept or reject it.
APPEALS_ENABLED=true
# /help opens a private thread. HELP_CHANNEL_ID: where threads are made (empty = where /help
# is used). HELP_STAFF_ROLE_ID: the role pinged by "Get a human". Needs Create Private
# Threads and Manage Threads.
HELP_ENABLED=true
HELP_CHANNEL_ID=
HELP_STAFF_ROLE_ID=
# Welcome new members in this channel (empty = off). Needs "Server Members Intent" turned on
# in the Developer Portal. {user} {server} {rules} {help} are filled in; empty = the default.
WELCOME_CHANNEL_ID=
WELCOME_MESSAGE=
