# ============================================================
#  BOT SETTINGS (.env)
#  1. Copy this file and name the copy .env
#  2. Fill in the 3 MUST lines in section 1
#  3. Leave everything else blank to use the default
#  Lines starting with # are notes. Never share your .env file.
# ============================================================


# ---------- 1. MUST FILL ----------

# Your bot's login token. Discord Developer Portal > Bot > Reset Token.
DISCORD_TOKEN=

# Your free AI key. Get it at openrouter.ai/keys. Starts with sk-or-
OPENAI_COMPAT_API_KEY=

# A few words about your community, e.g. retro handheld modding
COMMUNITY_ABOUT=


# ---------- 2. RECOMMENDED ----------

# Channel where case reports and appeals go (members' warnings and bans). Right-click > Copy ID.
MOD_LOG_CHANNEL_ID=

# Separate channel for bot notices: updates, settings changes, help pings, AI problems.
# Keep it apart from the mod log. Blank = notices go to the mod log.
ACTIVITY_LOG_CHANNEL_ID=

# Your server ID. Makes slash commands show up at once. Optional.
DISCORD_GUILD_ID=


# ---------- 3. AI ----------

# Which AI service to use. Keep openrouter for the free setup.
# Other choices: anthropic, groq, gemini, openai_compatible, ollama, cli
AI_PROVIDER=openrouter

# Seconds to wait for the AI before giving up
AI_TIMEOUT=60

# Seconds a member waits between /ask questions. 0 = no wait.
ASK_COOLDOWN_SECONDS=10

# The AI model. Blank with openrouter = the bot picks a free one.
# Several models: comma separated. The first is used, the rest are backups.
OPENAI_COMPAT_MODEL=

# If the AI fails, try today's free OpenRouter models (true or false)
OPENROUTER_FREE_FALLBACK=true

# Bot personality. Blank = the built-in one.
# {name}, {server} and {community} are filled in automatically.
AI_SYSTEM_PROMPT=

# Channels where the bot answers every message, comma separated IDs.
# Blank = it only answers /ask, mentions and replies.
ASSISTANT_CHANNEL_IDS=

# Recent messages the bot reads before answering. 0 to 20. 0 = none.
CHAT_CONTEXT_MESSAGES=8

# Answer when someone mentions the bot or replies to it (true or false)
ASK_ON_MENTION=true

# Named model lists for /ai-mode. Format: fast=model-a,model-b; smart=model-c
AI_MODES=


# ---------- 4. BACKUP AI (optional) ----------

# A second AI service, used when the first one fails or runs out.
# groq and gemini have free tiers.
AI_BACKUP_PROVIDER=
AI_BACKUP_API_KEY=
AI_BACKUP_MODEL=

# A model that reads images, used for moderation. Optional.
AI_BACKUP_VISION_MODEL=

# Only for AI_BACKUP_PROVIDER=openai_compatible
AI_BACKUP_BASE_URL=


# ---------- 5. OTHER AI SERVICES (optional, leave blank) ----------

# Claude, a paid service. Set AI_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only for AI_PROVIDER=openai_compatible
OPENAI_COMPAT_BASE_URL=

# Optional: how your bot is credited on openrouter.ai
OPENROUTER_APP_NAME=
OPENROUTER_SITE_URL=

# Ollama: a model that runs on this same computer
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# A local command-line AI tool. The prompt goes in, the reply comes out.
AI_CLI_COMMAND=


# ---------- 6. DOCS (optional) ----------

# GitHub repos the bot can quote from, comma separated.
# Format: owner/repo   or   owner/repo.wiki  (for a wiki)
DOCS_REPOS=

# Words that send a question to one repo. Format: word=owner/repo; word2=owner/repo2
# Put longer names first.
DOCS_ROUTES=

# Optional GitHub token. Faster doc downloads and private repos. Read-only is enough.
GITHUB_TOKEN=

# How often to re-download the docs, in minutes. 360 = every 6 hours. 0 = once.
DOCS_REFRESH_MINUTES=360

# How many doc sections the AI gets per question
DOCS_EXCERPTS=4

# Let the AI reword a question to match the docs: fallback, always or off
DOCS_AI_QUERY=fallback


# ---------- 7. MODERATION (scams, piracy, rules) ----------

# Turn moderation on or off (true or false)
MOD_ENABLED=true

# What to do with a message. delete = remove it. flag = leave it up for a moderator.
MOD_ACTION=delete
MOD_PIRACY_ACTION=delete
MOD_RULE_ACTION=delete

# Hate speech always times the member out for review, whatever you pick here.
MOD_HATE_ACTION=delete

# Channel with your server rules. Blank = found automatically.
RULES_CHANNEL_ID=

# When the AI checks messages. off = rules only. suspicious = risky posts only (recommended).
# all = every message (costs more).
MOD_AI_SCAN=suspicious

# Model that reads images for moderation. Must accept images. Blank = default.
MOD_AI_MODEL=

# How sure the AI must be before it flags a post, 0.5 to 0.99.
# Higher = fewer flags.
MOD_MIN_CONFIDENCE=0.75

# Warnings before a member is timed out for review. The bot never bans.
MOD_WARN_LIMIT=3

# Days until a warning stops counting. 0 = never.
MOD_WARN_EXPIRY_DAYS=90

# Send members a private message when they get a warning (true or false)
MOD_DM_WARNINGS=true

# Scams the AI is very sure of go straight to a timeout. Off by default.
MOD_SEVERE_SCAM_REVIEW=false
MOD_SEVERE_CONFIDENCE=0.9

# Roles the bot never moderates, comma separated role IDs.
# People with Manage Messages are always skipped.
MOD_EXEMPT_ROLE_IDS=

# Your own domain lists, comma separated. Blank = use the built-in lists.
MOD_BLOCKED_DOMAINS=
MOD_ALLOWED_DOMAINS=
MOD_PIRACY_DOMAINS=

# AutoMod rule IDs that count as hate speech, comma separated. Blank = Slurs filter only.
MOD_HATE_AUTOMOD_RULE_IDS=

# Where cases and warnings are saved. Leave it as is.
MOD_DB_PATH=data/moderation.sqlite3


# ---------- 8. UPDATES AND HEALTH ----------

# Pull new versions from GitHub on its own and restart (true or false)
AUTO_UPDATE=true

# How often to check for updates, in minutes
UPDATE_CHECK_MINUTES=30

# Branch to follow. Blank = the branch this copy is on (usually main).
UPDATE_BRANCH=

# Advanced: open a pull request when an AI model stops working. Leave blank to skip.
HEALTH_GITHUB_REPO=
HEALTH_GITHUB_TOKEN=
HEALTH_PR_FILE=


# ---------- 9. COMMUNITY FEATURES (all off by default) ----------

# Warned members get an Appeal button in their DM (true or false)
APPEALS_ENABLED=false

# /help opens a private thread with staff (true or false)
HELP_ENABLED=false

# Channel for help threads. Blank = the channel where /help is used.
HELP_CHANNEL_ID=

# Role pinged when someone asks for a human. Needs Create and Manage Threads.
HELP_STAFF_ROLE_ID=

# Channel for welcome messages. Blank = no welcome. Needs Server Members Intent on.
WELCOME_CHANNEL_ID=

# Welcome text. {user} {server} {rules} {help} are filled in. Blank = default text.
WELCOME_MESSAGE=

# Let the AI write each welcome. Uses AI quota for every join (true or false)
WELCOME_AI=false


# ---------- 10. SERVER PROFILE (advanced, leave blank) ----------

# A file with one server's settings, e.g. servers/my-server/server.env
# Values in this file win over the profile.
SERVER_PROFILE=
