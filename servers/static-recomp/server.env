# Static Recomp community profile. Use it with SERVER_PROFILE=servers/static-recomp/server.env
# in .env. Anything also set in .env wins over this file.

COMMUNITY_ABOUT=static recompilation of video games (projects like xboxrecomp, ps3recomp and ReXGlue, which turn console game code into native PC programs)
AI_SYSTEM_PROMPT=You are a helpful assistant for a Discord community about static recompiled games.
OPENROUTER_APP_NAME=Static Recomp AI Discord Bot

DOCS_REPOS=sp00nznet/xboxrecomp,sp00nznet/ps3recomp,rexglue/rexglue-sdk,rexglue/rexglue-sdk.wiki
# "Xbox 360" must go to ReXGlue, not xboxrecomp, so that rule comes first.
DOCS_ROUTES=xbox 360,xbox360,x360,360=rexglue/rexglue-sdk; xbox=sp00nznet/xboxrecomp; ps3=sp00nznet/ps3recomp
